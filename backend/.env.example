# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to backend/.env and fill in your values
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://legaldoc:legaldoc_secret@localhost:5432/legaldoc

# Redis (optional – leave blank to disable background jobs)
REDIS_URL=redis://localhost:6379

# File Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt

# ============================================================
# AI PROVIDER - choose ONE and fill the matching key
# Options: openai | anthropic | gemini
# ============================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# LLM model override (leave blank for provider default)
LLM_MODEL=gpt-4o

# ============================================================
# DEMO MODE
# Set to "true" to run system without LLM key (cached outputs)
# ============================================================
DEMO_MODE=false

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=change-this-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
